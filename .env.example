# Set this explicitly: several boot guards key off it (DEV_BYPASS_RADIUS is
# only allowed with NODE_ENV=development or test).
NODE_ENV=development
PORT=4000
# Bind address. Defaults to 127.0.0.1 in production (loopback only: the port is
# unreachable from outside, so X-Forwarded-For cannot be forged) and 0.0.0.0
# otherwise (so a phone on the LAN can reach your dev server).
# Set HOST=0.0.0.0 on platforms that route in from outside (Vercel, Render, Fly,
# Railway, Docker) — there the platform, not a local proxy, terminates traffic.
HOST=
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=https://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/saudade
# Required. In production the server REFUSES to boot without a private random
# value of at least 32 characters (openssl rand -hex 32), and it refuses the
# built-in development secret on any non-local API_PUBLIC_URL.
JWT_SECRET=local-dev-only-secret-not-for-production-0000
ADMIN_LOGIN=admin
# Required in production: the server refuses to boot if it is empty or "admin".
ADMIN_PASSWORD=change-this-admin-password
# Local demo login for the admin console. NEVER enable outside a dev machine:
# there is no built-in fallback credential, and both values below must be set
# explicitly for the flag to work. Leave empty and disabled by default.
DEMO_ADMIN_ENABLED=false
DEMO_ADMIN_LOGIN=
DEMO_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,http://localhost:3002,http://localhost:8081,http://localhost:19006
MARKETPLACE_PUBLIC_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=saudade
# Cloudinary "Token-based authentication" key (Settings > Security). OPTIONAL
# add-on. Without it, signed photo delivery URLs NEVER EXPIRE: they stay valid
# until the asset is purged (J+7), and a kick, a block or an account deletion
# does not revoke a URL already handed out. Set it and every delivery URL gets
# a 15-minute expiry the CDN itself enforces. See around/photoDelivery.ts.
CLOUDINARY_AUTH_TOKEN_KEY=
RESEND_API_KEY=
MAIL_FROM=SAUDADE <orders@saudade.thehnh.tech>
MAIL_REPLY_TO=contact@thehnh.tech
MAIL_ADMIN_BCC=

# Picture me around
APPLE_BUNDLE_ID=tech.thehnh.saudade
# Sign in with Apple REST credentials — used ONLY to revoke the user's Apple
# token when the account is deleted (App Store Review 5.1.1(v)). All three are
# optional: without them the deletion still succeeds, it is just logged as
# unrevoked. APPLE_PRIVATE_KEY is the content of the .p8 file; literal "\n"
# sequences are accepted so the PEM fits on a single line.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
AROUND_MIN_WINDOW_MS=3600000
AROUND_MAX_WINDOW_MS=21600000
AROUND_DEFAULT_WINDOW_MS=14400000
AROUND_RETENTION_MS=604800000
PRESENCE_FRESH_MS=1800000
JOIN_MAX_ACCURACY_M=150
JOIN_MAX_FIX_AGE_MS=60000
JOIN_MIN_FIX_SPACING_MS=8000
JOIN_MAX_INTER_FIX_SPEED_MPS=10
# Complete bypass of the physical-presence check for the listed account ids,
# for App Store review only. Every bypassed join is logged and flagged
# suspicious in the membership audit. CLEAR THIS AND REDEPLOY once the app is
# approved — it must never outlive the review.
REVIEW_MODE_USER_IDS=
MODERATION_ALERT_EMAIL=
# Only allowed when NODE_ENV=development or test AND API_PUBLIC_URL is a
# localhost URL — the server refuses to boot otherwise (including when
# NODE_ENV is unset). Only "true"/"1"/"yes"/"on" enable it; any other value
# is treated as false.
DEV_BYPASS_RADIUS=false
